; Pawn Action Godot canonical runtime
; Gameplay, simulation and rendering stay isolated inside Godot.
config_version=5

[application]

config/name="Pawn Action"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=0
window/stretch/mode="canvas_items"

[input_devices]

; Touches must remain touch events, not synthetic left-clicks on FIRE.
; Unlike disabling mouse input when a touchscreen exists, this preserves
; an actual mouse on hybrid laptops/tablets while TouchControls is visible.
pointing/emulate_mouse_from_touch=false

[audio]

driver/enable_input=false

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
